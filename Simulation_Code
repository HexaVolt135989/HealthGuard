#include <Wire.h>
#include <DHT.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ================= PIN CONFIGURATION =================

#define SDA_PIN 8
#define SCL_PIN 9

#define DHT_PIN 4
#define DHT_TYPE DHT22

#define PM_POT_PIN 5

#define OLED_ADDR 0x3C
#define MPU_ADDR 0x68
#define MAX30102_ADDR 0x57

// ================= OLED =================

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

Adafruit_SSD1306 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &Wire,
  -1
);

// ================= DHT22 =================

DHT dht(DHT_PIN, DHT_TYPE);

// ================= VARIABLES =================

float temperature = 0;
float humidity = 0;

int heartRate = 0;
int spo2 = 0;

int pm1_0 = 0;
int pm2_5 = 0;
int pm10 = 0;

float ax = 0;
float ay = 0;
float az = 0;

float gx = 0;
float gy = 0;
float gz = 0;

bool mpuDetected = false;
bool max30102Detected = false;

unsigned long lastUpdate = 0;
int displayPage = 0;

// =====================================================
// CHECK I2C DEVICE
// =====================================================

bool deviceExists(byte address)
{
  Wire.beginTransmission(address);
  return (Wire.endTransmission() == 0);
}

// =====================================================
// WRITE MPU6050 REGISTER
// =====================================================

void writeRegister(byte address, byte reg, byte value)
{
  Wire.beginTransmission(address);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission();
}

// =====================================================
// MPU6050 INITIALIZATION
// =====================================================

void initMPU6050()
{
  // Wake up MPU6050
  writeRegister(MPU_ADDR, 0x6B, 0x00);

  // Accelerometer ±2g
  writeRegister(MPU_ADDR, 0x1C, 0x00);

  // Gyroscope ±250°/s
  writeRegister(MPU_ADDR, 0x1B, 0x00);

  Serial.println("MPU6050 initialized");
}

// =====================================================
// READ MPU6050
// =====================================================

void readMPU6050()
{
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  Wire.endTransmission(false);

  Wire.requestFrom(MPU_ADDR, 14);

  if (Wire.available() >= 14)
  {
    int16_t rawAx = Wire.read() << 8 | Wire.read();
    int16_t rawAy = Wire.read() << 8 | Wire.read();
    int16_t rawAz = Wire.read() << 8 | Wire.read();

    // Skip MPU6050 temperature
    Wire.read();
    Wire.read();

    int16_t rawGx = Wire.read() << 8 | Wire.read();
    int16_t rawGy = Wire.read() << 8 | Wire.read();
    int16_t rawGz = Wire.read() << 8 | Wire.read();

    // Convert acceleration
    ax = rawAx / 16384.0;
    ay = rawAy / 16384.0;
    az = rawAz / 16384.0;

    // Convert gyroscope
    gx = rawGx / 131.0;
    gy = rawGy / 131.0;
    gz = rawGz / 131.0;
  }
}

// =====================================================
// SIMULATED HEART RATE + SPO2
// =====================================================

void readHealthInputs()
{
  /*
     MAX30102 is detected if connected,
     but HR and SpO2 are currently simulated.
  */

  heartRate = 72;
  spo2 = 98;
}

// =====================================================
// SIMULATED PMS5003
// =====================================================

void readPMInput()
{
  int potValue = analogRead(PM_POT_PIN);

  /*
     Potentiometer:
     0 - 4095

     PM2.5:
     5 - 300 ug/m3
  */

  pm2_5 = map(potValue, 0, 4095, 5, 300);

  pm2_5 = constrain(pm2_5, 5, 300);

  // Generate related PM values
  pm1_0 = pm2_5 * 0.45;
  pm10 = pm2_5 * 1.40;

  pm1_0 = constrain(pm1_0, 1, 500);
  pm10 = constrain(pm10, 5, 500);
}

// =====================================================
// HEALTH STATUS
// =====================================================

String getStatus()
{
  if (heartRate < 50 ||
      heartRate > 120 ||
      spo2 < 94 ||
      temperature > 38.0 ||
      temperature < 35.0 ||
      pm2_5 > 100)
  {
    return "WARNING";
  }

  return "NORMAL";
}

// =====================================================
// OLED HEALTH PAGE
// =====================================================

void showHealthPage()
{
  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);

  display.setCursor(0, 0);
  display.println("HEALTHGUARD");

  display.setCursor(0, 12);
  display.print("Temp: ");
  display.print(temperature, 1);
  display.println(" C");

  display.setCursor(0, 23);
  display.print("Hum : ");
  display.print(humidity, 1);
  display.println(" %");

  display.setCursor(0, 34);
  display.print("HR  : ");
  display.print(heartRate);
  display.println(" BPM");

  display.setCursor(0, 45);
  display.print("SpO2: ");
  display.print(spo2);
  display.println(" %");

  display.setCursor(0, 56);
  display.print(getStatus());

  display.display();
}

// =====================================================
// OLED ENVIRONMENT PAGE
// =====================================================

void showEnvironmentPage()
{
  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);

  display.setCursor(0, 0);
  display.println("ENVIRONMENT");

  display.setCursor(0, 14);
  display.print("PM1.0 : ");
  display.print(pm1_0);
  display.println(" ug/m3");

  display.setCursor(0, 27);
  display.print("PM2.5 : ");
  display.print(pm2_5);
  display.println(" ug/m3");

  display.setCursor(0, 40);
  display.print("PM10  : ");
  display.print(pm10);
  display.println(" ug/m3");

  display.setCursor(0, 54);
  display.print("Status: ");
  display.print(getStatus());

  display.display();
}

// =====================================================
// SERIAL MONITOR
// =====================================================

void printSerialData()
{
  Serial.println();
  Serial.println("==============================");
  Serial.println("       HEALTHGUARD");
  Serial.println("==============================");

  Serial.print("Temperature : ");
  Serial.print(temperature, 1);
  Serial.println(" C");

  Serial.print("Humidity    : ");
  Serial.print(humidity, 1);
  Serial.println(" %");

  Serial.print("Heart Rate  : ");
  Serial.print(heartRate);
  Serial.println(" BPM");

  Serial.print("SpO2        : ");
  Serial.print(spo2);
  Serial.println(" %");

  Serial.println();

  Serial.println("MPU6050");

  Serial.print("Acceleration X: ");
  Serial.print(ax, 2);
  Serial.print("  Y: ");
  Serial.print(ay, 2);
  Serial.print("  Z: ");
  Serial.println(az, 2);

  Serial.print("Gyroscope X: ");
  Serial.print(gx, 2);
  Serial.print("  Y: ");
  Serial.print(gy, 2);
  Serial.print("  Z: ");
  Serial.println(gz, 2);

  Serial.println();

  Serial.println("SIMULATED PMS5003");

  Serial.print("PM1.0 : ");
  Serial.print(pm1_0);
  Serial.println(" ug/m3");

  Serial.print("PM2.5 : ");
  Serial.print(pm2_5);
  Serial.println(" ug/m3");

  Serial.print("PM10  : ");
  Serial.print(pm10);
  Serial.println(" ug/m3");

  Serial.println();

  Serial.print("System Status: ");
  Serial.println(getStatus());

  Serial.println("==============================");
}

// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("Starting HEALTHGUARD...");

  // ---------------- I2C ----------------

  Wire.begin(SDA_PIN, SCL_PIN);

  Serial.println("I2C started");

  // ---------------- DHT22 ----------------

  dht.begin();

  Serial.println("DHT22 initialized");

  // ---------------- OLED ----------------

  if (display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR))
  {
    Serial.println("OLED OK");

    display.clearDisplay();

    display.setTextColor(SSD1306_WHITE);

    // HEALTHGUARD SINGLE LINE
    display.setTextSize(1);
    display.setCursor(28, 20);
    display.println("HEALTHGUARD");

    // Separator line
    display.drawLine(25, 32, 103, 32, SSD1306_WHITE);

    // System ready
    display.setCursor(32, 40);
    display.println("SYSTEM READY");

    display.display();

    delay(2000);
  }
  else
  {
    Serial.println("OLED ERROR");
  }

  // ---------------- MPU6050 ----------------

  mpuDetected = deviceExists(MPU_ADDR);

  if (mpuDetected)
  {
    initMPU6050();
  }
  else
  {
    Serial.println("MPU6050 NOT FOUND");
  }

  // ---------------- MAX30102 ----------------

  max30102Detected = deviceExists(MAX30102_ADDR);

  if (max30102Detected)
  {
    Serial.println("MAX30102 DETECTED");
  }
  else
  {
    Serial.println("MAX30102 NOT DETECTED");
  }

  // ---------------- POTENTIOMETER ----------------

  pinMode(PM_POT_PIN, INPUT);

  Serial.println("PM simulation input ready");

  Serial.println();
  Serial.println("HEALTHGUARD SYSTEM STARTED");
}

// =====================================================
// LOOP
// =====================================================

void loop()
{
  // ---------------- DHT22 ----------------

  float newTemperature = dht.readTemperature();
  float newHumidity = dht.readHumidity();

  if (!isnan(newTemperature))
  {
    temperature = newTemperature;
  }

  if (!isnan(newHumidity))
  {
    humidity = newHumidity;
  }

  // ---------------- HR / SPO2 ----------------

  readHealthInputs();

  // ---------------- MPU6050 ----------------

  if (mpuDetected)
  {
    readMPU6050();
  }

  // ---------------- PM SENSOR ----------------

  readPMInput();

  // ---------------- OUTPUT ----------------

  if (millis() - lastUpdate >= 1000)
  {
    lastUpdate = millis();

    if (displayPage == 0)
    {
      showHealthPage();
      displayPage = 1;
    }
    else
    {
      showEnvironmentPage();
      displayPage = 0;
    }

    printSerialData();
  }

  delay(50);
}
